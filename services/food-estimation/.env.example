# Keep the real file outside source control, readable only by the service user.
DATA_DIR=/var/lib/boji-food-estimation
PORT=8787
# JSON owner -> SHA-256 hash of a unique 32-byte random access token.
BOJI_OWNERS_JSON='{"personal":"REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS"}'
# Leave ALL four provider settings absent for explicit unavailable mode.
# PROVIDER_URL=https://your-provider.example/v1/chat/completions
# PROVIDER_NAME=Your provider
# PROVIDER_MODEL=Your image-capable model
# PROVIDER_KEY=Set through the deployment secret environment
# POLICY_VERSION=personal-v1
# PROVIDER_RETENTION=Describe the actual provider retention policy
MINUTE_JOBS=5
DAILY_ATTEMPTS=50
